# 数据库配置
DB_HOST=127.0.0.1
DB_NAME=campus_api
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_PERSISTENT=true

# JWT 密钥（生产环境请执行: openssl rand -base64 32 生成，或使用下方随机值并再次随机化）
JWT_SECRET=a7Xk2Qp9mN4vR8tY1bG5wJ3cL6fH0oE2sU9xW4zM7kB
JWT_EXPIRE_HOURS=168

# 文件存储（本地磁盘）
STORAGE_DRIVER=local

# CORS 跨域（多个域名用逗号分隔，* 表示允许所有来源；生产环境应指定具体域名）
CORS_ALLOWED_ORIGIN=*

# 应用配置
APP_URL=http://localhost/campus_api
APP_DEBUG=false
SESSION_SEED=1
